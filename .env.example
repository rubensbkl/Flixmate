# Copie para .env e preencha. O .env não é versionado.

# Ambiente e porta da API
ENV=dev
PORT=6789

# Banco (os valores abaixo batem com o serviço postgres do docker-compose.dev.yml)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cinematch
DB_USER=cinematch
DB_PASSWORD=cinematch

# Segredo de assinatura do JWT: gere um valor longo e aleatório
# openssl rand -base64 48
JWT_SECRET=troque_este_valor

# Chave da API do TMDB: https://developer.themoviedb.org/docs
TMDB_API_KEY=

# URL que o frontend usa para falar com a API
NEXT_PUBLIC_API_URL=http://localhost:6789

# Cache opcional. Sem Redis no ar o serviço de IA funciona, só não cacheia.
REDIS_HOST=redis
REDIS_PORT=6379
